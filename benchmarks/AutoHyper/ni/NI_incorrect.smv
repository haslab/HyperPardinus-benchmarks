MODULE main
VAR
MASK_0 : 0..1;
MASK_1 : 0..1;
MASK_2 : 0..1;
PIN_0 : 0..1;
PIN_1 : 0..1;
PIN_2 : 0..1;
RESULT_0 : 0..1;
RESULT_1 : 0..1;
RESULT_2 : 0..1;
alpha_line : 0..6;
beta_line : 0..6;
main_trigger : 0..2;
theta_line : 0..6;
trigger_alpha : boolean;
trigger_beta : boolean;
DEFINE
halt := ((MASK_1 = 0) & (MASK_2 = 0) & (theta_line = 0) & (MASK_0 = 0));
ASSIGN
    init(MASK_0) := 0;
    init(MASK_1) := 0;
    init(MASK_2) := 1;
    init(PIN_0) := {1 , 0};
    init(PIN_1) := {1 , 0};
    init(PIN_2) := {1 , 0};
    init(RESULT_0) := 0;
    init(RESULT_1) := 0;
    init(RESULT_2) := 0;
    init(alpha_line) := 0;
    init(beta_line) := 0;
    init(main_trigger) := 0;
    init(theta_line) := 0;
    init(trigger_alpha) := FALSE;
    init(trigger_beta) := FALSE;
    next(MASK_0) := case
        ((theta_line = 6) & (MASK_1 = 1)) : 1;
        ((theta_line = 6) & (MASK_0 = 1)) : 0;
        (TRUE) : MASK_0;
        esac;
    next(MASK_1) := case
        ((theta_line = 6) & (MASK_2 = 1)) : 1;
        ((theta_line = 6) & (MASK_1 = 1)) : 0;
        (TRUE) : MASK_1;
        esac;
    next(MASK_2) := case
        ((theta_line = 6) & (MASK_2 = 1)) : 0;
        (TRUE) : MASK_2;
        esac;
    next(PIN_0) := PIN_0;
    next(PIN_1) := PIN_1;
    next(PIN_2) := PIN_2;
    next(RESULT_0) := case
        ((alpha_line = 2) & ((RESULT_0 = 1) | (MASK_0 = 1))) : 1;
        ((alpha_line = 2) & (! ((RESULT_0 = 1) | (MASK_0 = 1)))) : 0;
        ((beta_line = 2) & (RESULT_0 = 1) & (MASK_0 = 0)) : 1;
        ((beta_line = 2) & (! ((RESULT_0 = 1) & (MASK_0 = 0)))) : 0;
        (TRUE) : RESULT_0;
        esac;
    next(RESULT_1) := case
        ((alpha_line = 2) & ((RESULT_1 = 1) | (MASK_1 = 1))) : 1;
        ((alpha_line = 2) & (! ((RESULT_1 = 1) | (MASK_1 = 1)))) : 0;
        ((beta_line = 2) & (RESULT_1 = 1) & (MASK_1 = 0)) : 1;
        ((beta_line = 2) & (! ((RESULT_1 = 1) & (MASK_1 = 0)))) : 0;
        (TRUE) : RESULT_1;
        esac;
    next(RESULT_2) := case
        ((alpha_line = 2) & ((RESULT_2 = 1) | (MASK_2 = 1))) : 1;
        ((alpha_line = 2) & (! ((RESULT_2 = 1) | (MASK_2 = 1)))) : 0;
        ((beta_line = 2) & (RESULT_2 = 1) & (MASK_2 = 0)) : 1;
        ((beta_line = 2) & (! ((RESULT_2 = 1) & (MASK_2 = 0)))) : 0;
        (TRUE) : RESULT_2;
        esac;
    next(alpha_line) := case
        ((MASK_1 = 0) & (MASK_2 = 0) & (alpha_line = 0) & (MASK_0 = 0)) : 0;
        ((alpha_line = 0) & (! ((MASK_0 = 0) & (MASK_2 = 0) & (MASK_1 = 0)))) : 1;
        ((alpha_line = 1) & (trigger_alpha = FALSE)) : 1;
        ((alpha_line = 1) & (trigger_alpha = TRUE)) : 2;
        (alpha_line = 2) : 3;
        (alpha_line = 3) : 4;
        (alpha_line = 4) : 5;
        (alpha_line = 5) : 6;
        (alpha_line = 6) : 0;
        esac;
    next(beta_line) := case
        ((MASK_1 = 0) & (MASK_2 = 0) & (beta_line = 0) & (MASK_0 = 0)) : 0;
        ((beta_line = 0) & (! ((MASK_0 = 0) & (MASK_2 = 0) & (MASK_1 = 0)))) : 1;
        ((beta_line = 1) & (trigger_beta = FALSE)) : 1;
        ((beta_line = 1) & (trigger_beta = TRUE)) : 2;
        (beta_line = 2) : 3;
        (beta_line = 3) : 4;
        (beta_line = 4) : 5;
        (beta_line = 5) : 6;
        (beta_line = 6) : 0;
        esac;
    next(main_trigger) := case
        (theta_line = 1) : 0;
        ((alpha_line = 4) & (main_trigger = 0)) : 1;
        ((alpha_line = 4) & (main_trigger = 1)) : 2;
        ((beta_line = 4) & (main_trigger = 0)) : 1;
        ((beta_line = 4) & (main_trigger = 1)) : 2;
        (TRUE) : main_trigger;
        esac;
    next(theta_line) := case
        ((MASK_1 = 0) & (MASK_2 = 0) & (theta_line = 0) & (MASK_0 = 0)) : 0;
        ((theta_line = 0) & (! ((MASK_0 = 0) & (MASK_2 = 0) & (MASK_1 = 0)))) : 1;
        (theta_line = 1) : 2;
        ((PIN_1 = MASK_1) & (PIN_2 = MASK_2) & (theta_line = 2) & (PIN_0 = MASK_0)) : 3;
        (theta_line = 3) : 5;
        ((theta_line = 2) & (! ((PIN_0 = MASK_0) & (PIN_2 = MASK_2) & (PIN_1 = MASK_1)))) : 4;
        (theta_line = 4) : 5;
        ((theta_line = 5) & (! (main_trigger = 2))) : 5;
        ((theta_line = 5) & (main_trigger = 2)) : 6;
        (theta_line = 6) : 0;
        esac;
    next(trigger_alpha) := case
        (theta_line = 3) : TRUE;
        ((beta_line = 5) & (main_trigger = 1)) : TRUE;
        (alpha_line = 3) : FALSE;
        (TRUE) : trigger_alpha;
        esac;
    next(trigger_beta) := case
        (theta_line = 4) : TRUE;
        ((alpha_line = 5) & (main_trigger = 1)) : TRUE;
        (beta_line = 3) : FALSE;
        (TRUE) : trigger_beta;
        esac;