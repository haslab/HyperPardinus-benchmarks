MODULE main
VAR
act : 1..4;
x_axis : 0..9;
y_axis : 0..9;
DEFINE
BEGIN := (((x_axis = 0) & (y_axis = 0)) | ((x_axis = 1) & (y_axis = 0)) | ((x_axis = 2) & (y_axis = 0)));
GOAL := (((x_axis = 6) & (y_axis = 9)) | ((x_axis = 7) & (y_axis = 9)) | ((x_axis = 8) & (y_axis = 9)));
ASSIGN
    init(act) := 1;
    init(x_axis) := {0 , 1 , 2};
    init(y_axis) := 0;
    next(act) := case
        ((x_axis = 0) & (y_axis = 0)) : {1 , 4};
        ((x_axis = 0) & ((y_axis = 9) | (y_axis = 8) | (y_axis = 7) | (y_axis = 5) | (y_axis = 6))) : act;
        ((x_axis = 1) & ((y_axis = 9) | (y_axis = 8) | (y_axis = 6) | (y_axis = 7))) : act;
        ((x_axis = 2) & ((y_axis = 7) | (y_axis = 8) | (y_axis = 9))) : act;
        ((x_axis = 3) & ((y_axis = 8) | (y_axis = 9))) : act;
        ((x_axis = 4) & (y_axis = 9)) : act;
        ((x_axis = 9) & ((y_axis = 4) | (y_axis = 3) | (y_axis = 2) | (y_axis = 0) | (y_axis = 1))) : act;
        ((x_axis = 8) & ((y_axis = 3) | (y_axis = 2) | (y_axis = 0) | (y_axis = 1))) : act;
        ((x_axis = 7) & ((y_axis = 0) | (y_axis = 1) | (y_axis = 2))) : act;
        ((x_axis = 6) & ((y_axis = 0) | (y_axis = 1))) : act;
        ((x_axis = 5) & (y_axis = 0)) : act;
        ((x_axis = 0) & (y_axis = 3)) : 4;
        ((x_axis = 1) & (y_axis = 4)) : {2 , 4};
        ((x_axis = 2) & (y_axis = 5)) : {2 , 4};
        ((x_axis = 3) & (y_axis = 6)) : {2 , 4};
        ((x_axis = 4) & (y_axis = 7)) : {2 , 4};
        ((x_axis = 5) & (y_axis = 8)) : 4;
        ((x_axis = 3) & (y_axis = 0)) : 1;
        ((x_axis = 4) & (y_axis = 1)) : {1 , 3};
        ((x_axis = 5) & (y_axis = 2)) : {1 , 3};
        ((x_axis = 6) & (y_axis = 3)) : {1 , 3};
        ((x_axis = 7) & (y_axis = 4)) : {1 , 3};
        ((x_axis = 8) & (y_axis = 5)) : 1;
        (x_axis = 0) : {1 , 4};
        (x_axis = 9) : {2 , 3};
        (y_axis = 0) : {1 , 4};
        (y_axis = 9) : {2 , 3};
        (TRUE) : {1 , 2 , 3 , 4};
        esac;
    next(x_axis) := case
        ((act = 1) | (act = 2)) : x_axis;
        ((x_axis = 0) & (y_axis = 0) & (act = 4)) : 1;
        ((x_axis = 0) & (! (y_axis = 0)) & (act = 3)) : 1;
        ((x_axis = 0) & (! (y_axis = 0)) & (act = 4)) : 1;
        ((x_axis = 1) & (act = 3)) : 0;
        ((x_axis = 1) & (act = 4)) : 2;
        ((x_axis = 2) & (act = 3)) : 1;
        ((x_axis = 2) & (act = 4)) : 3;
        ((x_axis = 3) & (act = 3)) : 2;
        ((x_axis = 3) & (act = 4)) : 4;
        ((x_axis = 4) & (act = 3)) : 3;
        ((x_axis = 4) & (act = 4)) : 5;
        ((x_axis = 5) & (act = 3)) : 4;
        ((x_axis = 5) & (act = 4)) : 6;
        ((x_axis = 6) & (act = 3)) : 5;
        ((x_axis = 6) & (act = 4)) : 7;
        ((x_axis = 7) & (act = 3)) : 6;
        ((x_axis = 7) & (act = 4)) : 8;
        ((x_axis = 8) & (act = 3)) : 7;
        ((x_axis = 8) & (act = 4)) : 9;
        ((x_axis = 9) & (act = 3)) : 8;
        (TRUE) : x_axis;
        esac;
    next(y_axis) := case
        ((act = 3) | (act = 4)) : y_axis;
        ((y_axis = 0) & (x_axis = 0) & (act = 1)) : 1;
        ((y_axis = 0) & (! (x_axis = 0)) & (act = 1)) : 1;
        ((y_axis = 0) & (! (x_axis = 0)) & (act = 2)) : 1;
        ((y_axis = 1) & (act = 2)) : 0;
        ((y_axis = 1) & (act = 1)) : 2;
        ((y_axis = 2) & (act = 2)) : 1;
        ((y_axis = 2) & (act = 1)) : 3;
        ((y_axis = 3) & (act = 2)) : 2;
        ((y_axis = 3) & (act = 1)) : 4;
        ((y_axis = 4) & (act = 2)) : 3;
        ((y_axis = 4) & (act = 1)) : 5;
        ((y_axis = 5) & (act = 2)) : 4;
        ((y_axis = 5) & (act = 1)) : 6;
        ((y_axis = 6) & (act = 2)) : 5;
        ((y_axis = 6) & (act = 1)) : 7;
        ((y_axis = 7) & (act = 2)) : 6;
        ((y_axis = 7) & (act = 1)) : 8;
        ((y_axis = 8) & (act = 2)) : 7;
        ((y_axis = 8) & (act = 1)) : 9;
        ((y_axis = 9) & (act = 2)) : 8;
        (TRUE) : y_axis;
        esac;