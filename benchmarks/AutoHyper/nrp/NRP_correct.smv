MODULE main
VAR
line : 1..7;
receiver_actions : 0..2;
sender_actions : 0..4;
take_turns : 0..2;
thirdparty_actions : 0..3;
ASSIGN
    init(line) := 1;
    init(receiver_actions) := 0;
    init(sender_actions) := 0;
    init(take_turns) := 0;
    init(thirdparty_actions) := 0;
    next(line) := case
        ((line = 1) & (! (sender_actions = 2))) : 1;
        ((line = 1) & (sender_actions = 2)) : 2;
        ((line = 2) & (! (sender_actions = 4))) : 2;
        ((line = 2) & (sender_actions = 4)) : 3;
        (line = 3) : 4;
        ((line = 4) & (! (receiver_actions = 2))) : 4;
        ((line = 4) & (receiver_actions = 2)) : 5;
        (line = 5) : 6;
        (line = 6) : 7;
        (line = 7) : 7;
        esac;
    next(receiver_actions) := case
        (take_turns = 1) : {0 , 1 , 2};
        (! (take_turns = 1)) : 0;
        esac;
    next(sender_actions) := case
        (take_turns = 0) : {0 , 1 , 2 , 3 , 4};
        (! (take_turns = 0)) : 0;
        esac;
    next(take_turns) := case
        (line = 3) : take_turns;
        (line = 6) : take_turns;
        (line = 7) : take_turns;
        (take_turns = 0) : 1;
        (take_turns = 1) : 2;
        (take_turns = 2) : 0;
        esac;
    next(thirdparty_actions) := case
        (line = 3) : 1;
        (line = 5) : 2;
        (line = 6) : 3;
        (take_turns = 2) : {0 , 1 , 2 , 3};
        (! (take_turns = 2)) : 0;
        esac;