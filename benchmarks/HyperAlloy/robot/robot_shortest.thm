<?xml version="1.0"?>
<alloy>

<view nodetheme="Martha" edgetheme="Martha">

<defaultnode/>

<defaultedge/>

<node>
   <type name="Int"/>
   <type name="String"/>
   <type name="univ"/>
   <type name="ordering/Ord"/>
   <type name="seq/Int"/>
</node>

<node color="Gray">
   <type name="Board"/>
</node>

<node hideunconnected="yes" shape="Ellipse" label="P">
   <type name="Position"/>
</node>

<node showlabel="no">
   <set name="$first" type="Position"/>
   <set name="$last" type="Position"/>
</node>

<edge visible="no">
   <relation name="$next"> <type name="Position"/> <type name="Position"/> </relation>
   <relation name="$prev"> <type name="Position"/> <type name="Position"/> </relation>
</edge>

<edge visible="no" attribute="yes">
   <relation name="obstacles"> <type name="Board"/> <type name="Position"/> <type name="Position"/> </relation>
</edge>

</view>

</alloy>
